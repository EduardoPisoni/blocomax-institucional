---
import BotaoWhatsapp from './BotaoWhatsapp.astro';
import { cidades, empresa, mensagens, whatsappLink } from '../data/site';
---
<section id="cidades" class="secao secao--clara" aria-labelledby="titulo-cidades">
  <div class="container grade">
    <div class="revelar">
      <h2 id="titulo-cidades">Onde atendemos</h2>
      <p class="apoio">A Blocomax fica em <strong>{empresa.cidade}</strong> e atende a <strong>toda a região</strong>.</p>
      <div class="fora-da-lista">
        <p>Sua cidade não está na lista?</p>
        <BotaoWhatsapp href={whatsappLink(mensagens.geral)} rotulo="Pergunte pelo WhatsApp" />
      </div>
    </div>
    <ul>
      {cidades.map((cidade, indice) => <li class="revelar" style={`--ordem: ${indice}`}>{cidade}</li>)}
      <li class="revelar regiao" style={`--ordem: ${cidades.length}`}>e toda a região</li>
    </ul>
  </div>
</section>

<style>
  .grade {
    display: grid;
    gap: 2rem;
  }

  .apoio {
    margin-top: 0.75rem;
    color: var(--cinza-escuro);
  }

  .fora-da-lista {
    display: grid;
    justify-items: start;
    gap: 1rem;
    margin-top: 2rem;
  }

  .fora-da-lista p {
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
  }

  ul {
    display: grid;
    align-content: start;
  }

  li {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--cinza-linha);
    font-weight: 600;
    transition: border-color var(--transicao), padding-left var(--transicao);
  }

  .regiao {
    border-bottom: 0;
    color: var(--laranja-mais-escuro); /* --laranja não atinge 4,5:1 no fundo claro */
    font-style: italic;
  }

  @media (hover: hover) {
    li:not(.regiao):hover {
      border-bottom-color: var(--laranja);
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    li:not(.regiao):hover {
      padding-left: 0.5rem;
    }
  }

  @media (min-width: 60rem) {
    .grade {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
    }
  }
</style>
