---
import BotaoWhatsapp from './BotaoWhatsapp.astro';
import { mensagens, whatsappLink } from '../data/site';
---
<section class="chamada" aria-labelledby="titulo-chamada">
  <div class="container">
    <div class="conteudo">
      <div>
        <h2 id="titulo-chamada">Pronto para tirar a casa do papel?</h2>
        <p>Mande uma mensagem. <strong>Você não precisa ter tudo definido</strong> para pedir um orçamento.</p>
      </div>
      <div class="acoes">
        <BotaoWhatsapp href={whatsappLink(mensagens.geral)} rotulo="Chamar no WhatsApp" />
        <a class="outras" href="/contato">Outras formas de contato</a>
      </div>
    </div>
  </div>
</section>

<style>
  .chamada {
    /* Continua o fundo da seção de cidades, que vem logo antes */
    padding-bottom: var(--secao);
    background: var(--fundo-claro);
  }

  .conteudo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding: clamp(1.75rem, 5vw, 3rem);
    border-radius: var(--raio-grande);
    background: var(--gradiente-laranja);
    color: var(--preto);
    box-shadow: var(--sombra);
  }

  .acoes {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .outras {
    padding-block: 0.25rem;
    font-weight: 600;
    text-underline-offset: 0.3em;
  }

  p {
    margin-top: 0.5rem;
  }

  @media (min-width: 60rem) {
    .conteudo {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 3rem;
    }
  }
</style>
