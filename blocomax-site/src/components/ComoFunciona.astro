---
import SeloIcone from './SeloIcone.astro';
import { passos } from '../data/site';
---
<section id="como-funciona" class="secao" aria-labelledby="titulo-como-funciona">
  <div class="container">
    <div class="titulo-secao">
      <h2 id="titulo-como-funciona">Do terreno à entrega da chave</h2>
      <p>Construir pela primeira vez gera muitas dúvidas. Veja o caminho, <strong>etapa por etapa</strong>.</p>
    </div>

    <ol class="passos">
      {
        passos.map((passo, indice) => (
          <li>
            <div class="marca">
              <SeloIcone nome={passo.icone} />
              <span class="numero" aria-hidden="true">{indice + 1}</span>
            </div>
            <div>
              <h3>{passo.titulo}</h3>
              <p set:html={passo.texto} />
            </div>
          </li>
        ))
      }
    </ol>

    <p class="proximo"><a class="link-seta" href="#obras">Ver exemplos de obras</a></p>
  </div>
</section>

<style>
  .passos {
    display: grid;
    gap: 2rem;
  }

  li {
    display: flex;
    gap: 1rem;
  }

  .marca {
    position: relative;
    flex: none;
    align-self: flex-start;
    transition: scale var(--transicao);
  }

  /* Texto preto: branco sobre --laranja fica em 2,4:1 */
  .numero {
    position: absolute;
    top: -0.5rem;
    left: -0.5rem;
    display: grid;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 50%;
    background: var(--laranja);
    box-shadow: 0 0 0 3px var(--branco);
    color: var(--preto);
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1;
  }

  h3 {
    margin-bottom: 0.375rem;
  }

  li p {
    color: var(--cinza-escuro);
  }

  .proximo {
    margin-top: 2.5rem;
    width: 100%;
    text-align: center;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    li:hover .marca {
      scale: 1.1;
    }
  }

  @media (min-width: 40rem) {
    .passos {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem 3rem;
    }
  }

  @media (min-width: 60rem) {
    .passos {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
